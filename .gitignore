src_backup_20260510/
legacy_archive/

# 第三方库（不推，用 requirements.txt 代替）
lib/

# 个人记忆文件
MEMORY.md

# IDE / AI assistant configs (personal, not project)
.vscode/
.idea/
.claude/
.cursor/
.gemini/
.kiro/
.qoder/
.mcp.json
.opencode.json
